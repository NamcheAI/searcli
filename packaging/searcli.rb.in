# TEMPLATE ONLY: substitute the version and REAL release artifact checksums.
class Searcli < Formula
  desc "Read-only Google Search Console CLI"
  homepage "https://github.com/namcheai/searcli"
  version "@VERSION@"
  license "MIT"

  on_macos do
    on_arm do
      url "https://github.com/namcheai/searcli/releases/download/v@VERSION@/searcli_v@VERSION@_darwin_arm64.tar.gz"
      sha256 "@SHA256_ARM64@"
    end
    on_intel do
      url "https://github.com/namcheai/searcli/releases/download/v@VERSION@/searcli_v@VERSION@_darwin_amd64.tar.gz"
      sha256 "@SHA256_AMD64@"
    end
  end
  depends_on :macos

  def install
    bin.install "searcli"
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/searcli version")
    assert_match "accounts", shell_output("SEARCLI_HOME=#{testpath}/state #{bin}/searcli account list")
  end
end
